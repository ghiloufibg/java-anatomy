<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase 1 exercise: a jcstress suite (SB, MP, IRIW litmus tests in plain/release-acquire/volatile
  variants, plus a stress test for WriterPreferringReadWriteLock).

  Kept as its own module, not part of phase1/src/main, because jcstress relies on an annotation
  processor bundled in jcstress-core (it rewrites @JCStressTest classes at compile time into the
  padded, harness-driven classes it actually runs) and on its own uber-jar packaging, both of
  which are conventionally kept away from ordinary application code.

  This module is NOT wired into `mvn verify`'s test execution: jcstress forks a JVM per test
  combination and a real run takes minutes, which does not belong in an ordinary build. `verify`
  only compiles it. See README.md for how to actually run the suite.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.sevenrungs</groupId>
    <artifactId>seven-rungs-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>phase1-jcstress</artifactId>

  <name>Phase 1 exercise - jcstress suite</name>

  <dependencies>
    <dependency>
      <groupId>dev.sevenrungs</groupId>
      <artifactId>phase1</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jcstress</groupId>
      <artifactId>jcstress-core</artifactId>
      <version>${jcstress.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>jcstress</finalName>
    <plugins>
      <plugin>
        <!-- javac on this JDK does not auto-discover annotation processors found only on the
             classpath (the META-INF/services registration in jcstress-core is not enough by
             itself here); JCStressTestProcessor must be named explicitly, or the
             @JCStressTest classes below never get rewritten into runnable harnesses and
             /META-INF/TestList is never generated, which jcstress.jar fails on at startup. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessors>
            <annotationProcessor>org.openjdk.jcstress.infra.processors.JCStressTestProcessor</annotationProcessor>
          </annotationProcessors>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.openjdk.jcstress.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
