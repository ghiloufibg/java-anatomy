<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase 1: Concurrency internals and the Java Memory Model.
  QuorumRead needs the enable-preview flag: JEP 505 (Structured Concurrency) is still a
  preview feature in JDK 25 (fifth preview), even though JEP 506 (Scoped Values)
  next to it is final. The flag is needed at compile time (javac), run time
  (exec-maven-plugin / `java`), and test time (Surefire), so it is set on all three.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.sevenrungs</groupId>
    <artifactId>seven-rungs-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>concurrency-jmm</artifactId>

  <name>Phase 1 - Concurrency and the JMM</name>

  <properties>
    <!-- extra program argument for rungs that read args[0] (only StoreBuffering does);
         override with -Dexec.programArgs=volatile -->
    <exec.programArgs></exec.programArgs>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>--enable-preview</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <!-- exec:java runs in-process and cannot load a class compiled with the enable-preview
             flag (the JVM only honors that flag at its own launch), so every rung here runs via
             exec:exec, which forks a real `java` process instead. Since this module has no
             runtime dependencies beyond the JDK, `target/classes` alone is a correct classpath. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <executable>java</executable>
          <arguments>
            <argument>--enable-preview</argument>
            <argument>-cp</argument>
            <argument>${project.build.outputDirectory}</argument>
            <argument>${exec.mainClass}</argument>
            <argument>${exec.programArgs}</argument>
          </arguments>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>--enable-preview</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
